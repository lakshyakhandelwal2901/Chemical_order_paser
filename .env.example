# Copy this file to .env and fill in your key
GOOGLE_API_KEY=your-google-api-key-here

# Optional overrides
PORT=3001
# Gemini models that can handle this extraction work:
#   gemini-3.7-flash      - fast, current stable model for structured JSON extraction
#   gemini-3.6-flash      - previous stable model, also supported
GEMINI_MODEL=gemini-3.7-flash

# Optional: busyNotify mock inventory API base URL
BUSYNOTIFY_API_BASE_URL=http://127.0.0.1:8000
